{
  "name": "securedesk",
  "version": "1.0.0",
  "private": true,
  "description": "API de déclaration et de suivi d'incidents sécurisée par une chaîne DevSecOps.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "supertest": "7.3.1",
    "vitest": "5.0.4"
  }
}
